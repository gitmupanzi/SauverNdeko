model T_Article {
  ID_Article                  Int                @id @default(autoincrement())
  ID_TypeArticleFk            Int?
  ID_CategorieArticleFk       Int?
  ID_UserFK                   Int?
  ID_UniteFk                  Int?
  DateHeureAuto               DateTime?          @db.Timestamptz(6)
  CodeArticleExterne          Int?
  NomArticle                  String             @db.VarChar(100)
  RefArticle                  String?            @db.VarChar(255)
  QteArticle                  Decimal            @default(0) @db.Decimal(14, 3)
  PUArticle                   Decimal            @db.Decimal(12, 2)
  PVArticle                   Decimal            @db.Decimal(12, 2)
  QteMinArticle               Int?
  PhotoArticle                String?            @db.VarChar(255)
  ObsArticle                  String?
  ValideArticle               Boolean            @default(true)
  DatePeremptionArticle       DateTime?          @db.Timestamptz(6)
  DatePeremptionAlerteArticle DateTime?          @db.Timestamptz(6)
  NbreJoursAlerteArticle      Int?
  CodeArticleInterne          String?            @unique(map: "uq_article_codeinterne") @db.VarChar(243)
  T_Recherche                 T_Recherche[]      @relation("RechercheArticle")
  T_Utilisateurs              T_Utilisateurs?    @relation("ArticleUser", fields: [ID_UserFK], references: [IdUser], onDelete: NoAction, map: "Fk_ID_User")
  T_CommandeDetail            T_CommandeDetail[]
  T_Mouvement                 T_Mouvement[]

  @@index([ID_CategorieArticleFk], map: "idx_article_categorie")
  @@index([NomArticle], map: "idx_article_nom")
  @@index([NomArticle(ops: raw("gin_trgm_ops"))], map: "idx_article_nom_trgm", type: Gin)
  @@index([ID_TypeArticleFk], map: "idx_article_type")
  @@index([ID_UniteFk], map: "idx_article_unite")
  @@schema("logistique")
}

model T_Commande {
  ID_Commande            Int                @id @default(autoincrement())
  ID_TypeCmdFk           Int?
  ID_StatutCmdFk         Int?
  ID_ClientFk            Int?
  ID_UserFk              Int?
  geolocalisationCmd     String?            @db.VarChar(255)
  DateHeureAutoCmd       DateTime?          @db.Timestamptz(6)
  DateCmd                DateTime?          @db.Timestamptz(6)
