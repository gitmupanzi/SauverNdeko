generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["analytics", "communication", "geolocalisation", "logistique", "operations", "professionnel", "referentiel", "systeme"]
}

model T_Recherche {
  IdRecherche        Int                      @id(map: "Pk_IdRecherche") @default(autoincrement())
  IdUserFk           Int?
  TexteRecherche     String
  TypeRecherche      String?                  @db.VarChar(50)
  ID_ArticleResultFk Int?
  IdEntiteResultFk   Int?
  IdSpecialiteFk     Int?
  LatitudeUser       Decimal?                 @db.Decimal(9, 6)
  LongitudeUser      Decimal?                 @db.Decimal(9, 6)
  DateRecherche      DateTime?                @default(now()) @db.Timestamp(6)
  TexteRecherche_tsv Unsupported("tsvector")? @default(dbgenerated("to_tsvector('french'::regconfig, COALESCE(\"TexteRecherche\", ''::text))"))
  T_Article          T_Article?               @relation("RechercheArticle", fields: [ID_ArticleResultFk], references: [ID_Article], map: "Fk_Recherche_Article")
  T_Entite           T_Entite?                @relation("RechercheEntite", fields: [IdEntiteResultFk], references: [IdEntite], map: "Fk_Recherche_Entite")
  T_Generique        T_Generique?             @relation("RechercheSpecialite", fields: [IdSpecialiteFk], references: [ID_Generique], map: "Fk_Recherche_Specialite")
  T_Utilisateurs     T_Utilisateurs?          @relation("RechercheUser", fields: [IdUserFk], references: [IdUser], map: "Fk_Recherche_User")

  @@index([DateRecherche], map: "idx_recherche_date")
  @@index([IdEntiteResultFk], map: "idx_recherche_entite")
  @@index([TexteRecherche_tsv], map: "idx_recherche_fts", type: Gin)
  @@index([IdSpecialiteFk], map: "idx_recherche_specialite")
  @@index([IdSpecialiteFk, DateRecherche], map: "idx_recherche_specialite_date")
  @@index([TexteRecherche(ops: raw("gin_trgm_ops"))], map: "idx_recherche_texte_trgm", type: Gin)
  @@index([IdUserFk], map: "idx_recherche_user")
  @@index([IdUserFk, DateRecherche], map: "idx_recherche_user_date")
  @@schema("analytics")
}

model T_Chat {
  IdChat         Int             @id @default(autoincrement())
  TextChat       String?
  ChatFile       String?
  ChatLink       String?
  AuthorIdFk     Int?
  IdDiscussionFk Int?
  DateChat       DateTime        @default(now()) @db.Timestamptz(6)
  LuChat         Boolean         @default(false)
  T_Utilisateurs T_Utilisateurs? @relation("ChatAuthor", fields: [AuthorIdFk], references: [IdUser], onUpdate: SetNull, map: "AuthorIdFk")
  T_Discussion   T_Discussion?   @relation(fields: [IdDiscussionFk], references: [IdDiscussion], onDelete: Cascade, map: "Fk_Chat_Discussion")

  @@index([AuthorIdFk], map: "idx_chat_author")
  @@index([AuthorIdFk, IdChat(sort: Desc)], map: "idx_chat_author_idchat_desc")
  @@index([IdDiscussionFk, DateChat], map: "idx_chat_discussion_date")
  @@index([IdDiscussionFk, IdChat], map: "idx_chat_discussion_idchat")
  @@schema("communication")
}

model T_Communication {
  IdCommunication      Int             @id(map: "Pk_IdCommunication") @default(autoincrement())
  IdUserFk             Int?
  IdTypeCommunication  Int?
  ContenuCommunication String?
  DateCommunication    DateTime        @default(now()) @db.Timestamp(6)
  ObsCommunication     String?
  ValideCommunication  Boolean         @default(true)
  LectureCommunication Boolean         @default(false)
  IdEntiteFk           Int?
  T_Entite             T_Entite?       @relation("EntiteCommunications", fields: [IdEntiteFk], references: [IdEntite], map: "Fk_IdEntite")
  T_Generique          T_Generique?    @relation("CommunicationType", fields: [IdTypeCommunication], references: [ID_Generique], map: "Fk_IdTypeCommunication")
  T_Utilisateurs       T_Utilisateurs? @relation("CommunicationUser", fields: [IdUserFk], references: [IdUser], map: "Fk_IdUser")

  @@index([DateCommunication], map: "idx_comm_date")
  @@index([IdEntiteFk], map: "idx_comm_entite")
  @@index([IdTypeCommunication], map: "idx_comm_type")
  @@index([IdUserFk], map: "idx_comm_user")
  @@schema("communication")
}

model T_Niveau_0 {
  ID_Niveau_0      Int          @id @default(autoincrement())
  NomNiveau_0      String?      @db.VarChar(255)
  CodeNiveau_0     String?      @db.VarChar(10)
  geometryNiveau_0 String?
  T_Niveau_1       T_Niveau_1[] @relation("Niveau1Parent")

  @@schema("geolocalisation")
}

model T_Niveau_1_Old {
  ID_Niveau_1_Old      Int          @id @default(autoincrement())
  NomNiveau_1_Old      String?      @db.VarChar(255)
