  T_Generique_T_Niveau_2_ID_StatusDeploiFkToT_Generique    T_Generique? @relation("T_Niveau_2_ID_StatusDeploiFkToT_Generique", fields: [ID_StatusDeploiFk], references: [ID_Generique], onDelete: NoAction, map: "Fk_ID_StatusDeploiFk")
