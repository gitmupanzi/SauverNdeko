  surfaceNiveau_1    String?         @db.VarChar(255)
  timezoneNiveau_1   String?         @db.VarChar(255)
  wikidataNiveau_1   String?
  EtenduNiveau_1     String?
  ObsNiveau_1        String?
  FusionNiveau_1     Boolean?
  VisibleNiveau_1    Boolean         @default(true)
  VisibleNiveau_5    Boolean         @default(true)
  LatitudeNiveau_1   Decimal?        @db.Decimal(9, 6)
  LongitudeNiveau_1  Decimal?        @db.Decimal(9, 6)
  T_Niveau_0         T_Niveau_0?     @relation("Niveau1Parent", fields: [ID_Niveau_0_Fk], references: [ID_Niveau_0], onDelete: NoAction, map: "Fk_ID_Niveau_0")
  T_Niveau_1_Old     T_Niveau_1_Old? @relation("Niveau1Legacy", fields: [ID_Niveau_1_Old_Fk], references: [ID_Niveau_1_Old], onDelete: NoAction, map: "Fk_ID_Niveau_1_Old")
  T_Niveau_2         T_Niveau_2[]    @relation("Niveau2Parent")

  @@index([ID_Niveau_0_Fk])
  @@index([ID_Niveau_0_Fk], map: "idx_n1_id_niveau0_fk")
  @@index([ID_Niveau_1_Old_Fk], map: "idx_n1_id_niveau1_old_fk")
