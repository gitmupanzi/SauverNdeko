FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DJANGO_SETTINGS_MODULE=config.production
WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && useradd --create-home --uid 10001 sauverndeko
COPY --chown=sauverndeko:sauverndeko backend/ ./
RUN mkdir -p /app/media && chown sauverndeko:sauverndeko /app/media
USER sauverndeko
EXPOSE 5000
CMD ["python", "serve_production.py"]
