{
    admin off
    auto_https off
    servers {
        # Le frontal Render arrive par le réseau privé ; Cloudflare remplace
        # CF-Connecting-IP. Ne jamais reprendre la chaîne X-Forwarded-For reçue.
        trusted_proxies static private_ranges
        trusted_proxies_strict
        client_ip_headers CF-Connecting-IP
    }
}

# Render termine TLS. Seul Caddy écoute sur le port public du conteneur.
http://:{$PORT:10000} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    @backend path /api /api/* /SauverNdeko /SauverNdeko/* /django-admin /django-admin/* /health /health/
    handle @backend {
        reverse_proxy 127.0.0.1:5000 {
            # Ne jamais transmettre une valeur X-Forwarded-* fournie par l'usager.
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Port 443
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-For {client_ip}
        }
    }
    # Les médias privés passent exclusivement par les routes Django autorisées.
    @privateFiles path /media /media/* /backend /backend/* /SQL /SQL/* /deploy /deploy/* /.env /.env.* /.git /.git/* /.runtime /.runtime/*
    handle @privateFiles {
        respond 404
    }
    handle_path /static/* {
        root * /app/backend/staticfiles
        file_server
    }
    handle /assets/* {
        root * /app/frontend/dist
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /app/frontend/dist
        # La page React est servie directement, sans les protections de Django.
        header {
            Cache-Control no-cache
            Strict-Transport-Security "max-age=31536000"
            X-Frame-Options DENY
            Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        }
        try_files {path} /index.html
        file_server
    }
}
