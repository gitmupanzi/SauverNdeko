-- TOC entry 394 (class 1255 OID 63501)
-- Name: ps_crud_commandedetail(integer, integer, numeric, integer, integer, numeric, character varying); Type: PROCEDURE; Schema: logistique; Owner: postgres
--

CREATE PROCEDURE logistique.ps_crud_commandedetail(IN p_old_cmd_fk integer, IN p_old_article_fk integer, IN p_old_qte numeric, IN p_new_cmd_fk integer, IN p_new_article_fk integer, IN p_new_qte numeric, IN p_operation character varying)
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_op text;
    v_old_type_cmd_id integer;
    v_old_abr_type text;
    v_new_type_cmd_id integer;
    v_new_abr_type text;
    v_oper_stock_old varchar(1);
    v_oper_stock_new varchar(1);
    v_pu_mvt numeric(12,2);
BEGIN
    v_op := upper(trim(p_operation));

    IF v_op = 'INSERT' THEN
        IF p_new_qte IS NULL OR p_new_qte <= 0 THEN
            RAISE EXCEPTION
                'ps_crud_commandeDetail(INSERT) : QteCmdDetail invalide (=%).',
                p_new_qte;
        END IF;

        IF p_new_qte <> trunc(p_new_qte) THEN
            RAISE EXCEPTION
                'ps_crud_commandeDetail(INSERT) : QteCmdDetail=% incompatible avec T_Mouvement.QteMvt entier.',
                p_new_qte;
        END IF;

        SELECT c."ID_TypeCmdFk", g."AbrGenerique"
        INTO v_new_type_cmd_id, v_new_abr_type
        FROM logistique."T_Commande" c
        JOIN referentiel."T_Generique" g ON c."ID_TypeCmdFk" = g."ID_Generique"
        WHERE c."ID_Commande" = p_new_cmd_fk
        LIMIT 1;

        IF NOT FOUND THEN
            RAISE EXCEPTION
                'ps_crud_commandeDetail(INSERT) : commande % introuvable ou sans type.',
                p_new_cmd_fk;
        END IF;

        IF v_new_abr_type ILIKE 'entr%' THEN
            v_oper_stock_new := '+';
        ELSIF v_new_abr_type ILIKE 'sort%' THEN
            v_oper_stock_new := '-';
        ELSE
            RAISE EXCEPTION
                'ps_crud_commandeDetail(INSERT) : type de commande non gere (ID_TypeCmdFk=%).',
                v_new_type_cmd_id;
        END IF;

        PERFORM set_config('logistique.skip_article_report_mvt', 'on', true);
        CALL logistique.ps_update_qte_article(p_new_article_fk, p_new_qte, v_oper_stock_new);
        PERFORM set_config('logistique.skip_article_report_mvt', 'off', true);

        SELECT COALESCE("PVArticle", 0)
        INTO v_pu_mvt
        FROM logistique."T_Article"
        WHERE "ID_Article" = p_new_article_fk;

        IF NOT FOUND OR v_pu_mvt IS NULL THEN
            v_pu_mvt := 0;
        END IF;

        PERFORM set_config('logistique.allow_t_mouvement_write', 'on', true);

        INSERT INTO logistique."T_Mouvement" (
            "ID_TypeMvtFk",
            "ID_ArticleFk",
            "ID_cmdFk",
            "DateHeureAutoMvt",
            "DateMvt",
            "QteMvt",
            "PUMvt"
        )
        VALUES (
            v_new_type_cmd_id,
            p_new_article_fk,
            p_new_cmd_fk,
            now()::timestamp without time zone,
            now()::timestamp without time zone,
            p_new_qte::integer,
            v_pu_mvt
        );

        PERFORM set_config('logistique.allow_t_mouvement_write', 'off', true);
        RETURN;
    END IF;

    IF v_op = 'UPDATE' THEN
        IF p_old_cmd_fk IS NOT DISTINCT FROM p_new_cmd_fk
           AND p_old_article_fk IS NOT DISTINCT FROM p_new_article_fk
           AND p_old_qte IS NOT DISTINCT FROM p_new_qte THEN
            RETURN;
        END IF;

        IF p_new_qte IS NULL OR p_new_qte <= 0 THEN
            RAISE EXCEPTION
                'ps_crud_commandeDetail(UPDATE) : nouvelle QteCmdDetail invalide (=%).',
                p_new_qte;
        END IF;

        IF p_new_qte <> trunc(p_new_qte) THEN
            RAISE EXCEPTION
                'ps_crud_commandeDetail(UPDATE) : nouvelle QteCmdDetail=% incompatible avec T_Mouvement.QteMvt entier.',
                p_new_qte;
        END IF;

        IF p_old_cmd_fk IS NOT NULL AND p_old_article_fk IS NOT NULL AND p_old_qte IS NOT NULL THEN
            IF p_old_qte <> trunc(p_old_qte) THEN
                RAISE EXCEPTION
                    'ps_crud_commandeDetail(UPDATE) : ancienne QteCmdDetail=% incompatible avec T_Mouvement.QteMvt entier.',
                    p_old_qte;
            END IF;

            SELECT c."ID_TypeCmdFk", g."AbrGenerique"
            INTO v_old_type_cmd_id, v_old_abr_type
            FROM logistique."T_Commande" c
            JOIN referentiel."T_Generique" g ON c."ID_TypeCmdFk" = g."ID_Generique"
            WHERE c."ID_Commande" = p_old_cmd_fk
            LIMIT 1;

            IF NOT FOUND THEN
                SELECT m."ID_TypeMvtFk", g."AbrGenerique"
                INTO v_old_type_cmd_id, v_old_abr_type
                FROM logistique."T_Mouvement" m
                JOIN referentiel."T_Generique" g ON m."ID_TypeMvtFk" = g."ID_Generique"
                WHERE m."ID_ArticleFk" = p_old_article_fk
                  AND m."ID_cmdFk" = p_old_cmd_fk
                LIMIT 1;
            END IF;

            IF NOT FOUND THEN
                RAISE EXCEPTION
                    'ps_crud_commandeDetail(UPDATE) : ancienne commande % introuvable.',
                    p_old_cmd_fk;
            END IF;

            IF v_old_abr_type ILIKE 'entr%' THEN
                v_oper_stock_old := '-';
            ELSIF v_old_abr_type ILIKE 'sort%' THEN
                v_oper_stock_old := '+';
            ELSE
                RAISE EXCEPTION
                    'ps_crud_commandeDetail(UPDATE) : ancien type non gere (ID_TypeCmdFk=%).',
                    v_old_type_cmd_id;
            END IF;

            PERFORM set_config('logistique.skip_article_report_mvt', 'on', true);
            CALL logistique.ps_update_qte_article(p_old_article_fk, p_old_qte, v_oper_stock_old);
            PERFORM set_config('logistique.skip_article_report_mvt', 'off', true);

            PERFORM set_config('logistique.allow_t_mouvement_write', 'on', true);

            DELETE FROM logistique."T_Mouvement"
            WHERE "ID_TypeMvtFk" = v_old_type_cmd_id
              AND "ID_ArticleFk" = p_old_article_fk
              AND "ID_cmdFk" = p_old_cmd_fk;

            PERFORM set_config('logistique.allow_t_mouvement_write', 'off', true);
        END IF;

        SELECT c."ID_TypeCmdFk", g."AbrGenerique"
        INTO v_new_type_cmd_id, v_new_abr_type
        FROM logistique."T_Commande" c
        JOIN referentiel."T_Generique" g ON c."ID_TypeCmdFk" = g."ID_Generique"
        WHERE c."ID_Commande" = p_new_cmd_fk
        LIMIT 1;

        IF NOT FOUND THEN
            RAISE EXCEPTION
                'ps_crud_commandeDetail(UPDATE) : nouvelle commande % introuvable.',
                p_new_cmd_fk;
        END IF;

        IF v_new_abr_type ILIKE 'entr%' THEN
            v_oper_stock_new := '+';
        ELSIF v_new_abr_type ILIKE 'sort%' THEN
            v_oper_stock_new := '-';
        ELSE
            RAISE EXCEPTION
                'ps_crud_commandeDetail(UPDATE) : nouveau type non gere (ID_TypeCmdFk=%).',
                v_new_type_cmd_id;
        END IF;

        PERFORM set_config('logistique.skip_article_report_mvt', 'on', true);
        CALL logistique.ps_update_qte_article(p_new_article_fk, p_new_qte, v_oper_stock_new);
        PERFORM set_config('logistique.skip_article_report_mvt', 'off', true);

        SELECT COALESCE("PVArticle", 0)
        INTO v_pu_mvt
        FROM logistique."T_Article"
        WHERE "ID_Article" = p_new_article_fk;

        IF NOT FOUND OR v_pu_mvt IS NULL THEN
            v_pu_mvt := 0;
        END IF;

        PERFORM set_config('logistique.allow_t_mouvement_write', 'on', true);

        INSERT INTO logistique."T_Mouvement" (
            "ID_TypeMvtFk",
            "ID_ArticleFk",
            "ID_cmdFk",
            "DateHeureAutoMvt",
            "DateMvt",
            "QteMvt",
            "PUMvt"
        )
        VALUES (
            v_new_type_cmd_id,
            p_new_article_fk,
            p_new_cmd_fk,
            now()::timestamp without time zone,
            now()::timestamp without time zone,
            p_new_qte::integer,
            v_pu_mvt
        );

        PERFORM set_config('logistique.allow_t_mouvement_write', 'off', true);
        RETURN;
    END IF;

    IF v_op = 'DELETE' THEN
        IF p_old_cmd_fk IS NULL OR p_old_article_fk IS NULL OR p_old_qte IS NULL THEN
            RAISE EXCEPTION
                'ps_crud_commandeDetail(DELETE) : parametres OLD incomplets.';
        END IF;

        IF p_old_qte <> trunc(p_old_qte) THEN
            RAISE EXCEPTION
                'ps_crud_commandeDetail(DELETE) : ancienne QteCmdDetail=% incompatible avec T_Mouvement.QteMvt entier.',
                p_old_qte;
        END IF;

        SELECT c."ID_TypeCmdFk", g."AbrGenerique"
        INTO v_old_type_cmd_id, v_old_abr_type
        FROM logistique."T_Commande" c
        JOIN referentiel."T_Generique" g ON c."ID_TypeCmdFk" = g."ID_Generique"
        WHERE c."ID_Commande" = p_old_cmd_fk
        LIMIT 1;

        IF NOT FOUND THEN
            SELECT m."ID_TypeMvtFk", g."AbrGenerique"
            INTO v_old_type_cmd_id, v_old_abr_type
            FROM logistique."T_Mouvement" m
            JOIN referentiel."T_Generique" g ON m."ID_TypeMvtFk" = g."ID_Generique"
            WHERE m."ID_ArticleFk" = p_old_article_fk
              AND m."ID_cmdFk" = p_old_cmd_fk
            LIMIT 1;
        END IF;

        IF NOT FOUND THEN
            RAISE EXCEPTION
                'ps_crud_commandeDetail(DELETE) : commande % introuvable.',
                p_old_cmd_fk;
        END IF;

        IF v_old_abr_type ILIKE 'entr%' THEN
            v_oper_stock_old := '-';
        ELSIF v_old_abr_type ILIKE 'sort%' THEN
            v_oper_stock_old := '+';
        ELSE
            RAISE EXCEPTION
                'ps_crud_commandeDetail(DELETE) : type non gere (ID_TypeCmdFk=%).',
                v_old_type_cmd_id;
        END IF;

        PERFORM set_config('logistique.skip_article_report_mvt', 'on', true);
        CALL logistique.ps_update_qte_article(p_old_article_fk, p_old_qte, v_oper_stock_old);
        PERFORM set_config('logistique.skip_article_report_mvt', 'off', true);

        PERFORM set_config('logistique.allow_t_mouvement_write', 'on', true);

        DELETE FROM logistique."T_Mouvement"
        WHERE "ID_TypeMvtFk" = v_old_type_cmd_id
          AND "ID_ArticleFk" = p_old_article_fk
          AND "ID_cmdFk" = p_old_cmd_fk;

        PERFORM set_config('logistique.allow_t_mouvement_write', 'off', true);
        RETURN;
    END IF;
END;
$$;


ALTER PROCEDURE logistique.ps_crud_commandedetail(IN p_old_cmd_fk integer, IN p_old_article_fk integer, IN p_old_qte numeric, IN p_new_cmd_fk integer, IN p_new_article_fk integer, IN p_new_qte numeric, IN p_operation character varying) OWNER TO postgres;

--
-- TOC entry 388 (class 1255 OID 63492)
-- Name: ps_update_qte_article(integer, numeric, character varying); Type: PROCEDURE; Schema: logistique; Owner: postgres
--

CREATE PROCEDURE logistique.ps_update_qte_article(IN p_id_article_fk integer, IN p_qte numeric, IN p_operateur character varying)
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_delta numeric;
    v_operateur varchar(1);
    v_new_stock numeric;
BEGIN
    IF p_qte IS NULL OR p_qte <= 0 THEN
        RAISE EXCEPTION
            'ps_update_qte_article : la quantite doit etre strictement positive (recu=%).',
            p_qte;
    END IF;

    v_operateur := trim(p_operateur);

    IF v_operateur NOT IN ('+', '-') THEN
        RAISE EXCEPTION
            'ps_update_qte_article : operateur invalide (recu=%). Utiliser seulement + ou -.',
            p_operateur;
    END IF;

    v_delta := CASE WHEN v_operateur = '+' THEN p_qte ELSE -p_qte END;

    UPDATE logistique."T_Article"
    SET "QteArticle" = COALESCE("QteArticle", 0)::numeric + v_delta
    WHERE "ID_Article" = p_id_article_fk
    RETURNING "QteArticle" INTO v_new_stock;

    IF NOT FOUND THEN
        RAISE EXCEPTION
            'ps_update_qte_article : article % introuvable.',
            p_id_article_fk;
    END IF;

    IF v_new_stock < 0 THEN
        RAISE EXCEPTION
            'ps_update_qte_article : la mise a jour ferait passer le stock de l''article % en negatif (stock final=%).',
            p_id_article_fk, v_new_stock;
    END IF;
END;
$$;


ALTER PROCEDURE logistique.ps_update_qte_article(IN p_id_article_fk integer, IN p_qte numeric, IN p_operateur character varying) OWNER TO postgres;

--
-- TOC entry 396 (class 1255 OID 63506)
-- Name: ps_update_totaux_commande(integer); Type: PROCEDURE; Schema: logistique; Owner: postgres
--

CREATE PROCEDURE logistique.ps_update_totaux_commande(IN p_id_commande integer)
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_montant_ht numeric(12,2);
BEGIN
    SELECT COALESCE(SUM(cd."QteCmdDetail" * cd."PUCmdDetail"), 0)
    INTO v_montant_ht
    FROM logistique."T_CommandeDetail" cd
    WHERE cd."ID_CmdFk" = p_id_commande;

    UPDATE logistique."T_Commande"
    SET "MontantHT" = v_montant_ht,
        "MontantTTC" = v_montant_ht
    WHERE "ID_Commande" = p_id_commande;
END;
$$;


ALTER PROCEDURE logistique.ps_update_totaux_commande(IN p_id_commande integer) OWNER TO postgres;

--
-- TOC entry 391 (class 1255 OID 63495)
-- Name: tr_crud_article_after(); Type: FUNCTION; Schema: logistique; Owner: postgres
--

CREATE FUNCTION logistique.tr_crud_article_after() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_new_qte numeric(14,3);
    v_old_qte numeric(14,3);
    v_delta numeric(14,3);
    v_type_mvt integer;
    v_qte_mvt integer;
    v_skip_report_mvt boolean;
BEGIN
    v_skip_report_mvt := COALESCE(current_setting('logistique.skip_article_report_mvt', true), 'off') = 'on';

    IF v_skip_report_mvt THEN
        RETURN NEW;
    END IF;

    IF TG_OP = 'INSERT' THEN
        v_new_qte := COALESCE(NEW."QteArticle", 0)::numeric(14,3);

        IF v_new_qte = 0 THEN
            RETURN NEW;
        END IF;

        IF v_new_qte <> trunc(v_new_qte) THEN
            RAISE EXCEPTION
                'tr_crud_article_after(INSERT) : QteArticle=% ne peut pas etre historisee dans T_Mouvement.QteMvt entier.',
                v_new_qte;
        END IF;

        SELECT g."ID_Generique"
        INTO v_type_mvt
        FROM referentiel."T_Generique" g
        WHERE g."AbrGenerique" ILIKE 'entr%'
        ORDER BY g."ID_Generique"
        LIMIT 1;

        IF v_type_mvt IS NULL THEN
            RAISE EXCEPTION 'tr_crud_article_after(INSERT) : type de mouvement Entree introuvable.';
        END IF;

        v_qte_mvt := v_new_qte::integer;
    ELSIF TG_OP = 'UPDATE' THEN
        v_old_qte := COALESCE(OLD."QteArticle", 0)::numeric(14,3);
        v_new_qte := COALESCE(NEW."QteArticle", 0)::numeric(14,3);
        v_delta := v_new_qte - v_old_qte;

        IF v_delta = 0 THEN
            RETURN NEW;
        END IF;

        IF abs(v_delta) <> trunc(abs(v_delta)) THEN
            RAISE EXCEPTION
                'tr_crud_article_after(UPDATE) : delta=% ne peut pas etre historise dans T_Mouvement.QteMvt entier.',
                v_delta;
        END IF;

        IF v_delta > 0 THEN
            SELECT g."ID_Generique"
            INTO v_type_mvt
            FROM referentiel."T_Generique" g
            WHERE g."AbrGenerique" ILIKE 'entr%'
            ORDER BY g."ID_Generique"
            LIMIT 1;

            IF v_type_mvt IS NULL THEN
                RAISE EXCEPTION 'tr_crud_article_after(UPDATE) : type de mouvement Entree introuvable.';
            END IF;

            v_qte_mvt := v_delta::integer;
        ELSE
            SELECT g."ID_Generique"
            INTO v_type_mvt
            FROM referentiel."T_Generique" g
            WHERE g."AbrGenerique" ILIKE 'sort%'
            ORDER BY g."ID_Generique"
            LIMIT 1;

            IF v_type_mvt IS NULL THEN
                RAISE EXCEPTION 'tr_crud_article_after(UPDATE) : type de mouvement Sortie introuvable.';
            END IF;

            v_qte_mvt := abs(v_delta)::integer;
        END IF;
    ELSE
        RETURN NEW;
    END IF;

    PERFORM set_config('logistique.allow_t_mouvement_write', 'on', true);

    INSERT INTO logistique."T_Mouvement" (
        "ID_TypeMvtFk",
        "ID_ArticleFk",
        "ID_cmdFk",
        "DateHeureAutoMvt",
        "DateMvt",
        "QteMvt",
        "PUMvt"
    )
    VALUES (
        v_type_mvt,
        NEW."ID_Article",
        NULL,
        now()::timestamp without time zone,
        now()::timestamp without time zone,
        v_qte_mvt,
        COALESCE(NEW."PVArticle", 0)
    );

    PERFORM set_config('logistique.allow_t_mouvement_write', 'off', true);
    RETURN NEW;
END;
$$;


ALTER FUNCTION logistique.tr_crud_article_after() OWNER TO postgres;

--
-- TOC entry 390 (class 1255 OID 63494)
-- Name: tr_crud_article_before(); Type: FUNCTION; Schema: logistique; Owner: postgres
--

CREATE FUNCTION logistique.tr_crud_article_before() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_new_qte numeric(14,3);
BEGIN
    IF TG_OP = 'INSERT' THEN
        v_new_qte := COALESCE(NEW."QteArticle", 0)::numeric(14,3);
        NEW."QteArticle" := v_new_qte;

        CALL logistique.ps_crud_article(NEW."ID_Article", NULL, v_new_qte, 'INSERT');
        RETURN NEW;
    ELSIF TG_OP = 'UPDATE' THEN
        NEW."QteArticle" := COALESCE(NEW."QteArticle", 0)::numeric(14,3);

        CALL logistique.ps_crud_article(
            NEW."ID_Article",
            COALESCE(OLD."QteArticle", 0)::numeric(14,3),
            NEW."QteArticle",
            'UPDATE'
        );
        RETURN NEW;
    ELSIF TG_OP = 'DELETE' THEN
        IF EXISTS (
            SELECT 1
            FROM logistique."T_CommandeDetail" cd
            WHERE cd."ID_ArticleFk" = OLD."ID_Article"
        ) THEN
            RAISE EXCEPTION
                'tr_crud_article(DELETE) : suppression interdite, article % lie a T_CommandeDetail.',
                OLD."ID_Article";
        END IF;

        IF EXISTS (
            SELECT 1
            FROM logistique."T_Mouvement" m
            WHERE m."ID_ArticleFk" = OLD."ID_Article"
        ) THEN
            RAISE EXCEPTION
                'tr_crud_article(DELETE) : suppression interdite, article % lie a T_Mouvement.',
                OLD."ID_Article";
        END IF;

        RETURN OLD;
    END IF;

    RETURN NEW;
END;
$$;


ALTER FUNCTION logistique.tr_crud_article_before() OWNER TO postgres;

--
-- TOC entry 393 (class 1255 OID 63499)
-- Name: tr_crud_commande(); Type: FUNCTION; Schema: logistique; Owner: postgres
--

CREATE FUNCTION logistique.tr_crud_commande() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF TG_OP = 'INSERT' THEN
        CALL logistique.ps_crud_commande(NEW."ID_Commande", NULL, NEW."ID_TypeCmdFk", 'INSERT');
        RETURN NEW;
    END IF;

    IF TG_OP = 'UPDATE' THEN
        CALL logistique.ps_crud_commande(NEW."ID_Commande", OLD."ID_TypeCmdFk", NEW."ID_TypeCmdFk", 'UPDATE');
        RETURN NEW;
    END IF;

    RETURN NEW;
END;
$$;


ALTER FUNCTION logistique.tr_crud_commande() OWNER TO postgres;

--
-- TOC entry 395 (class 1255 OID 63503)
-- Name: tr_crud_commandedetail(); Type: FUNCTION; Schema: logistique; Owner: postgres
--

CREATE FUNCTION logistique.tr_crud_commandedetail() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF TG_OP = 'INSERT' THEN
        CALL logistique.ps_crud_commandeDetail(
            NULL, NULL, NULL,
            NEW."ID_CmdFk", NEW."ID_ArticleFk", NEW."QteCmdDetail",
            'INSERT'
        );
        RETURN NEW;
    END IF;

    IF TG_OP = 'UPDATE' THEN
        CALL logistique.ps_crud_commandeDetail(
            OLD."ID_CmdFk", OLD."ID_ArticleFk", OLD."QteCmdDetail",
            NEW."ID_CmdFk", NEW."ID_ArticleFk", NEW."QteCmdDetail",
            'UPDATE'
        );
        RETURN NEW;
    END IF;

    IF TG_OP = 'DELETE' THEN
        CALL logistique.ps_crud_commandeDetail(
            OLD."ID_CmdFk", OLD."ID_ArticleFk", OLD."QteCmdDetail",
            NULL, NULL, NULL,
            'DELETE'
        );
        RETURN OLD;
    END IF;

    RETURN NEW;
END;
$$;


ALTER FUNCTION logistique.tr_crud_commandedetail() OWNER TO postgres;

--
-- TOC entry 387 (class 1255 OID 63413)
-- Name: tr_delete_commande(); Type: FUNCTION; Schema: logistique; Owner: postgres
--

CREATE FUNCTION logistique.tr_delete_commande() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    CALL logistique.ps_crud_commande(OLD."ID_Commande", OLD."ID_TypeCmdFk", NULL, 'DELETE');
    RETURN OLD;
END;
$$;


ALTER FUNCTION logistique.tr_delete_commande() OWNER TO postgres;

--
-- TOC entry 399 (class 1255 OID 63511)
-- Name: tr_lock_commande_cloturee(); Type: FUNCTION; Schema: logistique; Owner: postgres
--

CREATE FUNCTION logistique.tr_lock_commande_cloturee() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF OLD."StatusFacture" = 'Clôturée' THEN
        RAISE EXCEPTION
            'Commande % cloturee/facturee : modification ou suppression interdite.',
            OLD."ID_Commande";
    END IF;

    IF TG_OP = 'DELETE' THEN
        RETURN OLD;
    END IF;

    RETURN NEW;
END;
$$;


ALTER FUNCTION logistique.tr_lock_commande_cloturee() OWNER TO postgres;

--
-- TOC entry 398 (class 1255 OID 63509)
-- Name: tr_lock_mouvement_direct(); Type: FUNCTION; Schema: logistique; Owner: postgres
--

CREATE FUNCTION logistique.tr_lock_mouvement_direct() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF COALESCE(current_setting('logistique.allow_t_mouvement_write', true), 'off') = 'on' THEN
        IF TG_OP = 'DELETE' THEN
            RETURN OLD;
        END IF;
        RETURN NEW;
    END IF;

    RAISE EXCEPTION
        'T_Mouvement est geree par la logique metier. Ecriture directe interdite.';
END;
$$;


ALTER FUNCTION logistique.tr_lock_mouvement_direct() OWNER TO postgres;

--
-- TOC entry 397 (class 1255 OID 63507)
-- Name: tr_totaux_commande(); Type: FUNCTION; Schema: logistique; Owner: postgres
--

CREATE FUNCTION logistique.tr_totaux_commande() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_id_cmd integer;
BEGIN
    IF TG_OP = 'INSERT' THEN
        v_id_cmd := NEW."ID_CmdFk";
    ELSIF TG_OP = 'UPDATE' THEN
        IF OLD."ID_CmdFk" IS DISTINCT FROM NEW."ID_CmdFk" THEN
            CALL logistique.ps_update_totaux_commande(OLD."ID_CmdFk");
        END IF;
        v_id_cmd := NEW."ID_CmdFk";
    ELSIF TG_OP = 'DELETE' THEN
        v_id_cmd := OLD."ID_CmdFk";
    ELSE
        RETURN NEW;
    END IF;

    CALL logistique.ps_update_totaux_commande(v_id_cmd);

    IF TG_OP = 'DELETE' THEN
        RETURN OLD;
    END IF;

    RETURN NEW;
END;
$$;


ALTER FUNCTION logistique.tr_totaux_commande() OWNER TO postgres;

--
-- TOC entry 345 (class 1255 OID 55468)
-- Name: archive_paiements(); Type: FUNCTION; Schema: operations; Owner: postgres
--

CREATE FUNCTION operations.archive_paiements() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    INSERT INTO operations."T_Paiement_Archive" (
        "IdPaiement",
        "CodePaiement",
        "IdUserFk",
        "IdTypePaiementFk",
        "MontantPaiement",
        "IdStatutPaiementFk",
        "DatePaiement",
        "ObsPaiement",
        "ValidePaiement",
        "IdDeviseFk",
        "IdPayeurFk",
        "IdTypeMouvementFk",
        "DateArchivage",
        "IdEntiteFk"
    )
    SELECT
        p."IdPaiement",
        p."CodePaiement",
        p."IdUserFk",
        p."IdTypePaiementFk",
        p."MontantPaiement",
        p."IdStatutPaiementFk",
        p."DatePaiement",
        p."ObsPaiement",
        p."ValidePaiement",
        p."IdDeviseFk",
        p."IdPayeurFk",
        p."IdTypeMouvementFk",
        NOW() AS "DateArchivage",
        p."IdEntiteFk"
    FROM operations."T_Paiement" p
    WHERE p."DatePaiement" < NOW() - INTERVAL '2 years';

    DELETE FROM operations."T_Paiement"
    WHERE "DatePaiement" < NOW() - INTERVAL '2 years';

    RETURN NULL;
END;
$$;


ALTER FUNCTION operations.archive_paiements() OWNER TO postgres;

--
-- TOC entry 5600 (class 0 OID 0)
-- Dependencies: 345
-- Name: FUNCTION archive_paiements(); Type: COMMENT; Schema: operations; Owner: postgres
--

COMMENT ON FUNCTION operations.archive_paiements() IS 'Archiver dans T_Paiement_Archive les paiements de plus de 2 ans, puis les supprimer de T_Paiement.';


--
-- TOC entry 358 (class 1255 OID 55452)
-- Name: fn_audit_caisse(integer, integer, timestamp without time zone); Type: FUNCTION; Schema: operations; Owner: postgres
--

CREATE FUNCTION operations.fn_audit_caisse(p_id_entite integer DEFAULT NULL::integer, p_id_devise integer DEFAULT NULL::integer, p_date_max timestamp without time zone DEFAULT NULL::timestamp without time zone) RETURNS TABLE("IdEntite" integer, "NomEntite" character varying, "IdDevise" integer, "NomDevise" character varying, "SoldeCaisse" numeric, "SoldeTheorique" numeric, "Ecart" numeric, "NbPaiements" integer, "MontantEntree" numeric, "MontantSortie" numeric)
    LANGUAGE plpgsql
    AS $$
BEGIN
    RETURN QUERY
    WITH paiements_union AS (
        -- Unification paiements actifs + archivés, avec filtre sur date si fourni
        SELECT
            p."IdDeviseFk"       AS IdDevise,
            p."IdEntiteFk"       AS IdEntite,
            p."IdTypeMouvementFk",
            p."MontantPaiement",
            p."IdStatutPaiementFk",
            p."DatePaiement"
        FROM operations."T_Paiement" p

        UNION ALL

        SELECT
            pa."IdDeviseFk"      AS IdDevise,
            pa."IdEntiteFk"      AS IdEntite,
            pa."IdTypeMouvementFk",
            pa."MontantPaiement",
            pa."IdStatutPaiementFk",
            pa."DatePaiement"
        FROM operations."T_Paiement_Archive" pa
    ),
    flux AS (
        SELECT
            u.IdDevise,
            u.IdEntite,
            COUNT(*) FILTER (
                WHERE u."IdStatutPaiementFk" = 21
                  AND u."IdTypeMouvementFk" IN (80, 81)
                  AND u."IdDevise" IN (36, 37)
            )                          AS nb_paiements,
            SUM(
                CASE
                    WHEN u."IdStatutPaiementFk" = 21
                     AND u."IdTypeMouvementFk" = 81
                     AND u."IdDevise" IN (36, 37)
                        AND (p_date_max IS NULL OR u."DatePaiement" <= p_date_max)
                        THEN u."MontantPaiement"
                    ELSE 0
                END
            )                          AS montant_entree,
            SUM(
                CASE
                    WHEN u."IdStatutPaiementFk" = 21
                     AND u."IdTypeMouvementFk" = 80
                     AND u."IdDevise" IN (36, 37)
                        AND (p_date_max IS NULL OR u."DatePaiement" <= p_date_max)
                        THEN u."MontantPaiement"
                    ELSE 0
                END
            )                          AS montant_sortie
        FROM paiements_union u
        WHERE (p_id_entite IS NULL OR u.IdEntite = p_id_entite)
          AND (p_id_devise IS NULL OR u.IdDevise = p_id_devise)
        GROUP BY
            u.IdDevise,
            u.IdEntite
    )
    SELECT
        ent."IdEntite"                    AS "IdEntite",
        ent."NomEntite"                   AS "NomEntite",
        dev."ID_Generique"                AS "IdDevise",
        dev."NomGenerique"                AS "NomDevise",

        COALESCE(c."MontantCaisse", 0)::numeric                        AS "SoldeCaisse",

        COALESCE(
            (COALESCE(f.montant_entree, 0) - COALESCE(f.montant_sortie, 0)),
            0
        )::numeric                                                     AS "SoldeTheorique",

        COALESCE(c."MontantCaisse", 0)::numeric
          - COALESCE(
                (COALESCE(f.montant_entree, 0) - COALESCE(f.montant_sortie, 0)),
                0
            )::numeric                                                 AS "Ecart",

        COALESCE(f.nb_paiements, 0)::integer                           AS "NbPaiements",
        COALESCE(f.montant_entree, 0)::numeric                         AS "MontantEntree",
        COALESCE(f.montant_sortie, 0)::numeric                         AS "MontantSortie"

    FROM operations."T_Caisse" c
    LEFT JOIN flux f
           ON f.IdDevise = c."IdDeviseFk"
          AND f.IdEntite = c."IdEntiteFk"
    LEFT JOIN referentiel."T_Generique" dev
           ON dev."ID_Generique" = c."IdDeviseFk"
    LEFT JOIN systeme."T_Entite" ent
           ON ent."IdEntite" = c."IdEntiteFk"
    WHERE (p_id_entite IS NULL OR c."IdEntiteFk" = p_id_entite)
      AND (p_id_devise IS NULL OR c."IdDeviseFk" = p_id_devise)
    ORDER BY
        ent."NomEntite",
        dev."NomGenerique";
END;
$$;


ALTER FUNCTION operations.fn_audit_caisse(p_id_entite integer, p_id_devise integer, p_date_max timestamp without time zone) OWNER TO postgres;

--
-- TOC entry 5601 (class 0 OID 0)
-- Dependencies: 358
-- Name: FUNCTION fn_audit_caisse(p_id_entite integer, p_id_devise integer, p_date_max timestamp without time zone); Type: COMMENT; Schema: operations; Owner: postgres
--

COMMENT ON FUNCTION operations.fn_audit_caisse(p_id_entite integer, p_id_devise integer, p_date_max timestamp without time zone) IS 'Audit des caisses : pour chaque entité/devise, compare T_Caisse.MontantCaisse au solde théorique calculé depuis T_Paiement + T_Paiement_Archive.';


--
-- TOC entry 343 (class 1255 OID 55453)
-- Name: fn_audit_flux_caisse(integer, integer, timestamp without time zone, timestamp without time zone); Type: FUNCTION; Schema: operations; Owner: postgres
--

CREATE FUNCTION operations.fn_audit_flux_caisse(p_id_entite integer DEFAULT NULL::integer, p_id_devise integer DEFAULT NULL::integer, p_date_min timestamp without time zone DEFAULT NULL::timestamp without time zone, p_date_max timestamp without time zone DEFAULT NULL::timestamp without time zone) RETURNS TABLE("DateJour" timestamp without time zone, "IdEntite" integer, "NomEntite" character varying, "IdDevise" integer, "NomDevise" character varying, "MontantEntree" numeric, "MontantSortie" numeric, "NetJour" numeric)
    LANGUAGE plpgsql
    AS $$
BEGIN
    RETURN QUERY
    SELECT
        DATE_TRUNC('day', p."DatePaiement") AS "DateJour",
        p."IdEntiteFk"                      AS "IdEntite",
        ent."NomEntite"                     AS "NomEntite",
        p."IdDeviseFk"                      AS "IdDevise",
        dev."NomGenerique"                  AS "NomDevise",

        SUM(
            CASE
                WHEN p."IdStatutPaiementFk" = 21
                 AND p."IdTypeMouvementFk" = 81
                    THEN p."MontantPaiement"
                ELSE 0
            END
        )::numeric                          AS "MontantEntree",

        SUM(
            CASE
                WHEN p."IdStatutPaiementFk" = 21
                 AND p."IdTypeMouvementFk" = 80
                    THEN p."MontantPaiement"
                ELSE 0
            END
        )::numeric                          AS "MontantSortie",

        SUM(
            CASE
                WHEN p."IdStatutPaiementFk" = 21
                 AND p."IdTypeMouvementFk" = 81
                    THEN p."MontantPaiement"
                WHEN p."IdStatutPaiementFk" = 21
                 AND p."IdTypeMouvementFk" = 80
                    THEN -p."MontantPaiement"
                ELSE 0
            END
        )::numeric                          AS "NetJour"

    FROM operations."T_Paiement" p
    LEFT JOIN referentiel."T_Generique" dev
           ON dev."ID_Generique" = p."IdDeviseFk"
    LEFT JOIN systeme."T_Entite" ent
           ON ent."IdEntite" = p."IdEntiteFk"
    WHERE (p_id_entite IS NULL OR p."IdEntiteFk" = p_id_entite)
      AND (p_id_devise IS NULL OR p."IdDeviseFk" = p_id_devise)
      AND (p_date_min IS NULL OR p."DatePaiement" >= p_date_min)
      AND (p_date_max IS NULL OR p."DatePaiement" <= p_date_max)
    GROUP BY
        DATE_TRUNC('day', p."DatePaiement"),
        p."IdEntiteFk",
        ent."NomEntite",
        p."IdDeviseFk",
        dev."NomGenerique"
    ORDER BY
        "DateJour",
        "NomEntite",
        "NomDevise";
END;
$$;


ALTER FUNCTION operations.fn_audit_flux_caisse(p_id_entite integer, p_id_devise integer, p_date_min timestamp without time zone, p_date_max timestamp without time zone) OWNER TO postgres;

--
-- TOC entry 5602 (class 0 OID 0)
-- Dependencies: 343
-- Name: FUNCTION fn_audit_flux_caisse(p_id_entite integer, p_id_devise integer, p_date_min timestamp without time zone, p_date_max timestamp without time zone); Type: COMMENT; Schema: operations; Owner: postgres
--

COMMENT ON FUNCTION operations.fn_audit_flux_caisse(p_id_entite integer, p_id_devise integer, p_date_min timestamp without time zone, p_date_max timestamp without time zone) IS 'Audit paramétrable des flux de caisse (entrées / sorties / net) par jour, entité et devise.';


--
-- TOC entry 346 (class 1255 OID 55588)
-- Name: gestion_caisse_on_paiement(); Type: FUNCTION; Schema: operations; Owner: postgres
--

CREATE FUNCTION operations.gestion_caisse_on_paiement() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    -- Deltas à appliquer sur la caisse
    v_delta_old NUMERIC := 0;
    v_delta_new NUMERIC := 0;

    -- Variables de travail
    v_sign       INTEGER;
    v_is_paid    BOOLEAN;
    v_is_devise  BOOLEAN;
BEGIN
    --------------------------------------------------------------------
    -- 1) TRAITEMENT DE L'ANCIEN ENREGISTREMENT (OLD) → DELETE / UPDATE
    --------------------------------------------------------------------
    IF TG_OP IN ('UPDATE', 'DELETE') THEN
        v_delta_old := 0;
        v_sign      := 0;
        v_is_paid   := FALSE;
        v_is_devise := FALSE;

        -- a) Statut paiement = 'Payé(e)' dans catégorie 'Statut paiement' ?
        IF OLD."IdStatutPaiementFk" IS NOT NULL THEN
            SELECT
                ( lower(cg."NomCategorieGenerique") = 'statut paiement'
                  AND trim(g."NomGenerique") = 'Payé(e)' )
            INTO v_is_paid
            FROM referentiel."T_Generique" g
            JOIN referentiel."T_CategorieGenerique" cg
              ON cg."ID_CategorieGenerique" = g."ID_CategorieGeneriqueFk"
            WHERE g."ID_Generique" = OLD."IdStatutPaiementFk";
        END IF;

        -- b) Devise appartenant à la catégorie 'Devise' ?
        IF OLD."IdDeviseFk" IS NOT NULL THEN
            SELECT
                ( lower(cg."NomCategorieGenerique") = 'devise' )
            INTO v_is_devise
            FROM referentiel."T_Generique" g
            JOIN referentiel."T_CategorieGenerique" cg
              ON cg."ID_CategorieGenerique" = g."ID_CategorieGeneriqueFk"
            WHERE g."ID_Generique" = OLD."IdDeviseFk";
        END IF;

        -- c) Type mouvement paiement : 'Entrée' / 'Sortie' ?
        IF OLD."IdTypeMouvementFk" IS NOT NULL THEN
            SELECT
                CASE
                    WHEN lower(cg."NomCategorieGenerique") = 'type mouvement paiement'
                         AND g."NomGenerique" ILIKE 'entr%' THEN  1   -- Entrée
                    WHEN lower(cg."NomCategorieGenerique") = 'type mouvement paiement'
                         AND g."NomGenerique" ILIKE 'sort%' THEN -1   -- Sortie
                    ELSE 0
                END
            INTO v_sign
            FROM referentiel."T_Generique" g
            JOIN referentiel."T_CategorieGenerique" cg
              ON cg."ID_CategorieGenerique" = g."ID_CategorieGeneriqueFk"
            WHERE g."ID_Generique" = OLD."IdTypeMouvementFk";
        END IF;

        -- d) Calcul de l'effet OLD sur la caisse (qu'on doit annuler)
        IF OLD."ValidePaiement" IS TRUE
           AND v_is_paid
           AND v_is_devise
           AND v_sign <> 0
           AND OLD."IdEntiteFk" IS NOT NULL
        THEN
            -- Pour un DELETE ou la "sortie" de l'ancien état :
            -- delta_old = - (signe * MontantPaiement)
            v_delta_old := - v_sign * OLD."MontantPaiement";

            -- Appliquer delta_old à la caisse correspondante
            INSERT INTO operations."T_Caisse" AS c (
                "IdEntiteFk", "IdDeviseFk", "MontantCaisse"
            )
            VALUES (
                OLD."IdEntiteFk",
                OLD."IdDeviseFk",
                v_delta_old
            )
            ON CONFLICT ("IdEntiteFk", "IdDeviseFk")
            DO UPDATE
            SET "MontantCaisse" = c."MontantCaisse" + EXCLUDED."MontantCaisse";
        END IF;
    END IF;

    --------------------------------------------------------------------
    -- 2) TRAITEMENT DU NOUVEL ENREGISTREMENT (NEW) → INSERT / UPDATE
    --------------------------------------------------------------------
    IF TG_OP IN ('INSERT', 'UPDATE') THEN
        v_delta_new := 0;
        v_sign      := 0;
        v_is_paid   := FALSE;
        v_is_devise := FALSE;

        -- a) Statut paiement = 'Payé(e)' ?
        IF NEW."IdStatutPaiementFk" IS NOT NULL THEN
            SELECT
                ( lower(cg."NomCategorieGenerique") = 'statut paiement'
                  AND trim(g."NomGenerique") = 'Payé(e)' )
            INTO v_is_paid
            FROM referentiel."T_Generique" g
            JOIN referentiel."T_CategorieGenerique" cg
              ON cg."ID_CategorieGenerique" = g."ID_CategorieGeneriqueFk"
            WHERE g."ID_Generique" = NEW."IdStatutPaiementFk";
        END IF;

        -- b) Devise appartenant à la catégorie 'Devise' ?
        IF NEW."IdDeviseFk" IS NOT NULL THEN
            SELECT
                ( lower(cg."NomCategorieGenerique") = 'devise' )
            INTO v_is_devise
            FROM referentiel."T_Generique" g
            JOIN referentiel."T_CategorieGenerique" cg
              ON cg."ID_CategorieGenerique" = g."ID_CategorieGeneriqueFk"
            WHERE g."ID_Generique" = NEW."IdDeviseFk";
        END IF;

        -- c) Type mouvement : 'Entrée' / 'Sortie' ?
        IF NEW."IdTypeMouvementFk" IS NOT NULL THEN
            SELECT
                CASE
                    WHEN lower(cg."NomCategorieGenerique") = 'type mouvement paiement'
                         AND g."NomGenerique" ILIKE 'entr%' THEN  1
                    WHEN lower(cg."NomCategorieGenerique") = 'type mouvement paiement'
                         AND g."NomGenerique" ILIKE 'sort%' THEN -1
                    ELSE 0
                END
            INTO v_sign
            FROM referentiel."T_Generique" g
            JOIN referentiel."T_CategorieGenerique" cg
              ON cg."ID_CategorieGenerique" = g."ID_CategorieGeneriqueFk"
            WHERE g."ID_Generique" = NEW."IdTypeMouvementFk";
        END IF;

        -- d) Calcul de l'effet NEW sur la caisse
        IF NEW."ValidePaiement" IS TRUE
           AND v_is_paid
           AND v_is_devise
           AND v_sign <> 0
           AND NEW."IdEntiteFk" IS NOT NULL
        THEN
            -- Pour un INSERT ou la "nouvelle" version en UPDATE :
            -- delta_new = signe * MontantPaiement
            v_delta_new := v_sign * NEW."MontantPaiement";

            -- Appliquer delta_new à la caisse correspondante
            INSERT INTO operations."T_Caisse" AS c (
                "IdEntiteFk", "IdDeviseFk", "MontantCaisse"
            )
            VALUES (
                NEW."IdEntiteFk",
                NEW."IdDeviseFk",
                v_delta_new
            )
            ON CONFLICT ("IdEntiteFk", "IdDeviseFk")
            DO UPDATE
            SET "MontantCaisse" = c."MontantCaisse" + EXCLUDED."MontantCaisse";
        END IF;
    END IF;

    -- 3) Retour standard pour un trigger AFTER ROW
    IF TG_OP = 'DELETE' THEN
        RETURN OLD;
    ELSE
        RETURN NEW;
    END IF;
END;
$$;


