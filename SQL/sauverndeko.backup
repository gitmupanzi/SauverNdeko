--
-- TOC entry 319 (class 1259 OID 63519)
-- Name: V_AlertStock; Type: VIEW; Schema: logistique; Owner: postgres
--

CREATE VIEW logistique."V_AlertStock" AS
 SELECT "ID_Article",
    "NomArticle",
    "QteArticle",
    "QteMinArticle",
    ("QteArticle" - ("QteMinArticle")::numeric) AS "Marge"
   FROM logistique."T_Article" a
  WHERE ("QteMinArticle" IS NOT NULL);


ALTER VIEW logistique."V_AlertStock" OWNER TO postgres;

