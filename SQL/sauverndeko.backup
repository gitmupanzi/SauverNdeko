--
-- TOC entry 392 (class 1255 OID 63498)
-- Name: ps_crud_commande(integer, integer, integer, character varying); Type: PROCEDURE; Schema: logistique; Owner: postgres
--

CREATE PROCEDURE logistique.ps_crud_commande(IN p_id_commande integer, IN p_old_id_type_cmd integer, IN p_new_id_type_cmd integer, IN p_operation character varying)
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_op text;
BEGIN
    v_op := upper(trim(p_operation));

    IF v_op = 'INSERT' THEN
        IF p_new_id_type_cmd IS NOT NULL THEN
            PERFORM 1
            FROM referentiel."T_Generique" g
            WHERE g."ID_Generique" = p_new_id_type_cmd;

            IF NOT FOUND THEN
                RAISE EXCEPTION
                    'ps_crud_commande(INSERT) : ID_TypeCmdFk=% introuvable.',
                    p_new_id_type_cmd;
            END IF;
        END IF;
        RETURN;
    END IF;

    IF v_op = 'UPDATE' THEN
        IF p_old_id_type_cmd IS NOT DISTINCT FROM p_new_id_type_cmd THEN
            RETURN;
        END IF;

        IF p_new_id_type_cmd IS NULL THEN
            RAISE EXCEPTION
                'ps_crud_commande(UPDATE) : nouveau ID_TypeCmdFk NULL pour commande %.',
                p_id_commande;
        END IF;

        PERFORM 1
        FROM referentiel."T_Generique" g
        WHERE g."ID_Generique" = p_new_id_type_cmd;

        IF NOT FOUND THEN
            RAISE EXCEPTION
                'ps_crud_commande(UPDATE) : ID_TypeCmdFk=% introuvable.',
                p_new_id_type_cmd;
        END IF;

        PERFORM set_config('logistique.allow_t_mouvement_write', 'on', true);

        UPDATE logistique."T_Mouvement"
        SET "ID_TypeMvtFk" = p_new_id_type_cmd
        WHERE "ID_cmdFk" = p_id_commande;

        PERFORM set_config('logistique.allow_t_mouvement_write', 'off', true);
        RETURN;
    END IF;

    IF v_op = 'DELETE' THEN
        RETURN;
    END IF;
END;
$$;


ALTER PROCEDURE logistique.ps_crud_commande(IN p_id_commande integer, IN p_old_id_type_cmd integer, IN p_new_id_type_cmd integer, IN p_operation character varying) OWNER TO postgres;

