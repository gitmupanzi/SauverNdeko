--

CREATE FUNCTION systeme.update_licence_status() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF NEW."DateFin" < NOW() THEN
        NEW."ExpireeLicence" := TRUE;
    ELSE
        NEW."ExpireeLicence" := FALSE;
    END IF;

    RETURN NEW;
END;
$$;


