-- Dependencies: 379
-- Name: FUNCTION audit_log_function(); Type: COMMENT; Schema: systeme; Owner: postgres
--

COMMENT ON FUNCTION systeme.audit_log_function() IS 'Capture les modifications des tables (INSERT/UPDATE/DELETE) avec gestion de IdEntiteFk si disponible.';


