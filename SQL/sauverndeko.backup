--
-- TOC entry 383 (class 1255 OID 55514)
-- Name: prevent_multiple_active_licenses(); Type: FUNCTION; Schema: systeme; Owner: postgres
--

CREATE FUNCTION systeme.prevent_multiple_active_licenses() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    existing_count INT;
BEGIN
    SELECT COUNT(*) INTO existing_count 
    FROM systeme."T_Licence"
    WHERE "IdEntiteFk"     = NEW."IdEntiteFk"
      AND "ExpireeLicence" = FALSE;

    IF existing_count > 0 THEN
        RAISE EXCEPTION 'Cette entité possède déjà une licence active.';
    END IF;

    RETURN NEW;
END;
$$;


