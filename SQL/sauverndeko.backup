-- Name: ps_crud_article(integer, numeric, numeric, character varying); Type: PROCEDURE; Schema: logistique; Owner: postgres
--

CREATE PROCEDURE logistique.ps_crud_article(IN p_id_article integer, IN p_old_qte numeric, IN p_new_qte numeric, IN p_operation character varying)
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_op text;
    v_new_qte numeric(14,3);
BEGIN
    v_op := upper(trim(p_operation));
    v_new_qte := COALESCE(p_new_qte, 0)::numeric(14,3);

    IF v_op IN ('INSERT', 'UPDATE') AND v_new_qte < 0 THEN
        RAISE EXCEPTION
            'ps_crud_article(%) : QteArticle negative interdite pour ID_Article=%.',
            v_op, p_id_article;
    END IF;
END;
$$;


