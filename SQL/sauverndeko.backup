--
-- TOC entry 317 (class 1259 OID 62956)
-- Name: V_Admin_UI_Setting_Audit; Type: VIEW; Schema: systeme; Owner: postgres
--

CREATE VIEW systeme."V_Admin_UI_Setting_Audit" AS
 SELECT "IdLog",
    "TableName",
    "Operation",
    "ChangedAt",
    COALESCE(("NewData" ->> 'updatedByName'::text), ("OldData" ->> 'updatedByName'::text)) AS "UpdatedByName",
    COALESCE(("NewData" ->> 'updatedByUserId'::text), ("OldData" ->> 'updatedByUserId'::text)) AS "UpdatedByUserId",
    COALESCE(("NewData" ->> 'updatedAt'::text), ("OldData" ->> 'updatedAt'::text)) AS "UpdatedSettingAt",
    "OldData",
    "NewData"
   FROM systeme."T_Audit_Log" a
  WHERE ("TableName" = 'T_Admin_UI_Setting'::text)
  ORDER BY "ChangedAt" DESC;


ALTER VIEW systeme."V_Admin_UI_Setting_Audit" OWNER TO postgres;

--
-- TOC entry 296 (class 1259 OID 62721)
-- Name: V_Audit_log; Type: VIEW; Schema: systeme; Owner: postgres
--

CREATE VIEW systeme."V_Audit_log" AS
 SELECT a."IdLog",
    a."TableName",
    a."Operation",
    a."ChangedAt",
    e."NomEntite",
    a."OldData",
    a."NewData"
   FROM (systeme."T_Audit_Log" a
     LEFT JOIN systeme."T_Entite" e ON ((e."IdEntite" = a."IdEntiteFk")));


ALTER VIEW systeme."V_Audit_log" OWNER TO postgres;

--
-- TOC entry 297 (class 1259 OID 62725)
-- Name: V_Entite_Localisation_Detail; Type: VIEW; Schema: systeme; Owner: postgres
--

CREATE VIEW systeme."V_Entite_Localisation_Detail" AS
 SELECT el."IdEntiteLocalisation",
    e."IdEntite",
    e."NomEntite",
    e."PhoneEntite",
    e."EmailEntite",
    e."AdresseEntite",
    e."IdTypeEntiteFk",
    te."NomGenerique" AS "TypeEntite",
    el."Latitude",
    el."Longitude",
    el."AdresseDetaillee",
    el."DateCreation",
    el."IdNiveau_3_Fk",
    n3."NomNiveau_3",
    el."IdNiveau_4_Fk",
    n4."NomNiveau_4",
    el."IdNiveau_5_Fk",
    n5."NomNiveau_5"
   FROM (((((systeme."T_Entite" e
     LEFT JOIN systeme."T_Entite_Localisation" el ON ((el."IdEntiteFk" = e."IdEntite")))
     LEFT JOIN referentiel."T_Generique" te ON ((te."ID_Generique" = e."IdTypeEntiteFk")))
     LEFT JOIN geolocalisation."T_Niveau_3" n3 ON ((n3."ID_Niveau_3" = el."IdNiveau_3_Fk")))
     LEFT JOIN geolocalisation."T_Niveau_4" n4 ON ((n4."ID_Niveau_4" = el."IdNiveau_4_Fk")))
     LEFT JOIN geolocalisation."T_Niveau_5" n5 ON ((n5."ID_Niveau_5" = el."IdNiveau_5_Fk")));


ALTER VIEW systeme."V_Entite_Localisation_Detail" OWNER TO postgres;

--
-- TOC entry 298 (class 1259 OID 62730)
-- Name: V_Licence_active; Type: VIEW; Schema: systeme; Owner: postgres
--

CREATE VIEW systeme."V_Licence_active" AS
 SELECT l."IdLicence",
    l."IdEntiteFk",
    e."NomEntite",
    l."DateDebut",
    l."DateFin",
    l."ValideLicence",
    l."ExpireeLicence",
        CASE
            WHEN (l."DateFin" < CURRENT_DATE) THEN 'Expirée'::text
            WHEN (l."ExpireeLicence" = true) THEN 'Expirée'::text
            ELSE 'Active'::text
        END AS statut_licence
   FROM (systeme."T_Licence" l
     LEFT JOIN systeme."T_Entite" e ON ((e."IdEntite" = l."IdEntiteFk")));


ALTER VIEW systeme."V_Licence_active" OWNER TO postgres;

--
-- TOC entry 299 (class 1259 OID 62735)
-- Name: V_Login_history; Type: VIEW; Schema: systeme; Owner: postgres
--

CREATE VIEW systeme."V_Login_history" AS
 SELECT lg."IdLogin",
    lg."DateLogin",
    lg."IdTypeLoginFk",
    type_log."AbrGenerique" AS "TypeLogin",
    u."IdUser",
    u."NomUser",
    u."PrenomUser",
    u."EmailUser",
    e."IdEntite",
    e."NomEntite"
   FROM (((systeme."T_Login" lg
     JOIN systeme."T_Utilisateurs" u ON ((u."IdUser" = lg."IdUserFk")))
     LEFT JOIN systeme."T_Entite" e ON ((e."IdEntite" = lg."IdEntiteFk")))
     LEFT JOIN referentiel."T_Generique" type_log ON ((lg."IdTypeLoginFk" = type_log."ID_Generique")));


ALTER VIEW systeme."V_Login_history" OWNER TO postgres;

--
-- TOC entry 300 (class 1259 OID 62740)
-- Name: V_User_profil; Type: VIEW; Schema: systeme; Owner: postgres
--

CREATE VIEW systeme."V_User_profil" AS
 SELECT u."IdUser",
    u."NomUser",
    u."PrenomUser",
    u."EmailUser",
    u."PhoneUser",
    u."SexeUser",
    u."ValideUser",
    u."Is_staff",
    u."Is_Admin",
    u."DatecreationUser",
    e."IdEntite",
    e."NomEntite",
    e."EmailEntite",
    e."PhoneEntite"
   FROM (systeme."T_Utilisateurs" u
     LEFT JOIN systeme."T_Entite" e ON ((e."IdEntite" = u."IdEntiteFk")));


ALTER VIEW systeme."V_User_profil" OWNER TO postgres;

